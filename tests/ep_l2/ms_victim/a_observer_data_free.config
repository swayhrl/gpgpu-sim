-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_simple_dram_model 1
-gpgpu_l2_rop_latency 0
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:128:1,256:0,32
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_payload_mode 2

# Study subset; common parent config is provided by A/E. No trace input.
-gpgpu_ep_l2_tvd_clean 0
-gpgpu_ep_l2_tvd_dirty 0
-gpgpu_ep_l2_mq2 0
-gpgpu_ep_l2_rg1 0
-gpgpu_ep_l2_bank_ops 1

# A V2 source-only gate: full Tag geometry comes from the real fixture.
-gpgpu_ep_l2_tvd_clean 1
-gpgpu_ep_l2_tvd_dirty 1
-gpgpu_ep_l2_tvd_fixed_entries 0
-gpgpu_ep_l2_ms_observer 1
-gpgpu_ep_l2_diag_copy_free 0
-gpgpu_ep_l2_diag_l2_data_free 1
