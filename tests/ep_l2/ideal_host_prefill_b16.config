# Production-directed test only. No application metrics or qualification yet.
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_simple_dram_model 1
-gpgpu_l2_rop_latency 5
-gpgpu_dram_partition_queues 512:128:64:1
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:128:1,256:0,32
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_payload_mode 2
-gpgpu_ep_l2_ft_mode 1
-gpgpu_ep_l2_wbuf_entries 16
-gpgpu_ep_l2_ideal_wb 0
-gpgpu_ep_l2_ideal_meta 0
-gpgpu_ep_l2_ideal_read_hit 1
