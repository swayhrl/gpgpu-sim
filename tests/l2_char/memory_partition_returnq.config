# P5A overlay: one production partition/subpartition and a one-entry ReturnQ.
# The test injects direct lower requests through L2interface; no cache state is
# mocked and no FIFO is accessed outside its public interface.
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_dram_partition_queues 8:8:1:8
-gpgpu_frfcfs_dram_sched_queue_size 8
-gpgpu_dram_return_queue_size 8
-gpgpu_simple_dram_model 1
-gpgpu_l2_char_enable 1
-gpgpu_l2_char_window 16
-gpgpu_l2_char_returnq_hold_cycles 0
