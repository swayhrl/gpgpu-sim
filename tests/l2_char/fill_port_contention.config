# Two real reads return through DRAM->L2.  A one-byte port keeps R0's fill
# busy for a whole line while the one-entry L2->ICNT queue holds its response.
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_simple_dram_model 1
-gpgpu_l2_rop_latency 0
-gpgpu_dram_partition_queues 8:8:8:1
-gpgpu_cache:dl2 S:4:128:2,L:B:m:L:L,A:8:8,8:0,1
-gpgpu_l2_char_enable 1
-gpgpu_l2_char_window 16
