# C is a real line-allocation stall; D is a real ROP-ready request.  The
# production ICNT->L2 FIFO has exactly one entry and no ROP rule is altered.
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_simple_dram_model 1
-gpgpu_l2_rop_latency 0
-gpgpu_dram_partition_queues 1:8:8:8
-gpgpu_cache:dl2 S:1:128:2,L:B:m:L:L,A:4:4,8:0,32
-gpgpu_l2_char_dram_issue_hold_cycles 80
-gpgpu_l2_char_enable 1
-gpgpu_l2_char_window 16
