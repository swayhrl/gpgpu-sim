# Example-only overlay; do not run before bounded-trace namespace admission.
-gpgpu_l2_oracle_elastic_qweight_enable 1
-gpgpu_l2_oracle_elastic_protected_quota_bytes 8388608
-gpgpu_l2_oracle_elastic_protected_quota_lines 0
-gpgpu_l2_oracle_elastic_interval_sidecar /ABSOLUTE/PATH/oracle_intervals.tsv
-gpgpu_l2_oracle_elastic_sidecar_sha256 REPLACE_WITH_ACCEPTED_SHA256
-gpgpu_l2_oracle_elastic_diagnostics 1
