+    assert(f.cache->ep_l2_payload_for_test().request(h,false,f.gpu->gpu_sim_cycle)==P::GRANTED);
+    for(unsigned b=0;b<4;++b)injected_grants[b]+=f.cache->ep_l2_payload_bank_grants(b)-before[b];
