+void joint32(char **a,const char *command) {
+  reviewed_fixture g(a,command);auto &f=g.f;auto &ram=f.cache->ep_l2_payload_for_test();auto dir=f.cache->tvd_for_test();
+  f.memory[ro_base]={{ro_base+11,ro_base+22,ro_base+33,ro_base+44}};
